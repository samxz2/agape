---
import Layout from '../layouts/Layout.astro'
import ProductGrid from '../components/ProductGrid.vue'
import { productos } from '../data/productos'

const totalProductos = productos.length
---

<Layout title="Agape Collection Parfum">
  <!-- HERO -->
  <section
    class="relative min-h-[70vh] md:min-h-[80vh] flex items-center justify-center overflow-hidden bg-gradient-to-b from-cream-100 via-cream-50 to-cream-100"
  >
    <!-- Animated gradient orbs -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-32 -left-32 w-[500px] h-[500px] bg-gold-300/20 rounded-full blur-[120px] animate-float"></div>
      <div class="absolute -bottom-32 -right-32 w-[400px] h-[400px] bg-rose-300/20 rounded-full blur-[100px] animate-float-delayed"></div>
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-cream-300/30 rounded-full blur-[150px]"></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 text-center relative z-10">
      <div class="animate-fade-in-up" style="animation-delay: 0s">
        <span class="inline-block text-brown-400/80 uppercase tracking-[0.35em] text-xs md:text-sm mb-5 font-medium">
          Bienvenido a
        </span>
      </div>

      <h1 class="font-playfair text-5xl md:text-8xl text-brown-700 font-bold leading-[1.05] tracking-tight animate-fade-in-up" style="animation-delay: 0.12s">
        Agape
        <span class="block text-gradient">
          Collection
        </span>
      </h1>

      <p class="font-playfair italic text-xl md:text-3xl text-brown-400/70 mt-2 animate-fade-in-up" style="animation-delay: 0.22s">
        Parfum
      </p>

      <p class="max-w-2xl mx-auto mt-5 text-sm md:text-base text-brown-400/70 leading-relaxed animate-fade-in-up font-light" style="animation-delay: 0.32s">
        Descubre nuestra exclusiva colección de perfumes de nicho.
        Fragancias que definen momentos.
      </p>

      <!-- Stats -->
      <div class="flex items-center justify-center gap-8 md:gap-14 mt-8 animate-fade-in-up" style="animation-delay: 0.38s">
        <div class="text-center">
          <p class="text-brown-600 text-2xl md:text-3xl font-bold font-playfair">{totalProductos}</p>
          <p class="text-brown-400/60 text-[10px] md:text-xs uppercase tracking-[0.2em] mt-1">Productos</p>
        </div>
        <div class="w-px h-10 bg-brown-200/60"></div>
        <div class="text-center">
          <p class="text-brown-600 text-2xl md:text-3xl font-bold font-playfair">4</p>
          <p class="text-brown-400/60 text-[10px] md:text-xs uppercase tracking-[0.2em] mt-1">Categorías</p>
        </div>
        <div class="w-px h-10 bg-brown-200/60"></div>
        <div class="text-center">
          <p class="text-2xl md:text-3xl font-playfair">🇻🇪</p>
          <p class="text-brown-400/60 text-[10px] md:text-xs uppercase tracking-[0.2em] mt-1">Envío Venezuela</p>
        </div>
      </div>

      <!-- BOTONES -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10 animate-fade-in-up" style="animation-delay: 0.45s">
        <a
          href="#productos"
          class="group relative inline-flex items-center justify-center gap-2 bg-gradient-to-r from-brown-600 to-brown-500 text-cream-50 font-bold rounded-full transition-all duration-300 hover:shadow-[0_8px_30px_rgba(122,88,55,0.25)] hover:-translate-y-0.5 active:scale-[0.98] px-8 py-4 text-sm uppercase tracking-[0.15em]"
        >
          Explorar Colección
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>

        <a
          href="#productos"
          class="glass-dark text-brown-600 hover:text-brown-700 rounded-full transition-all duration-300 hover:bg-brown-100/30 px-8 py-4 text-sm uppercase tracking-[0.15em] font-medium active:scale-[0.98]"
        >
          Ver Categorías
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-pulse-subtle">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-brown-300/50">
        <line x1="12" y1="2" x2="12" y2="22"/>
        <polyline points="19 15 12 22 5 15"/>
      </svg>
    </div>
  </section>

  <!-- PRODUCTOS -->
  <section id="productos" class="py-16 md:py-24 bg-cream-50">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="inline-block text-brown-400 text-xs uppercase tracking-[0.3em] font-semibold mb-3">Colección Exclusiva</span>
        <h2 class="font-playfair text-4xl md:text-5xl text-brown-700 font-bold leading-tight">
          Nuestra Colección
        </h2>
        <div class="w-16 h-0.5 bg-gold-400/50 mx-auto mt-4 rounded-full"></div>
        <p class="text-brown-400 text-sm mt-4 max-w-lg mx-auto">
          Encuentra tu fragancia ideal · <span class="font-semibold text-brown-600">{totalProductos}</span> productos disponibles
        </p>
      </div>

      <ProductGrid client:load />
    </div>
  </section>

  <!-- WHATSAPP -->
  <a
    href={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMERO || '584127050149'}`}
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-6 right-6 z-40 bg-gradient-to-br from-green-500 to-green-600 hover:from-green-400 hover:to-green-500 text-white w-14 h-14 md:w-16 md:h-16 rounded-full flex items-center justify-center shadow-[0_8px_30px_rgba(34,197,94,0.35)] hover:shadow-[0_12px_40px_rgba(34,197,94,0.5)] hover:scale-110 active:scale-95 transition-all duration-300"
    aria-label="Contactar por WhatsApp"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
  </a>

  <!-- Back to top -->
  <button
    id="back-to-top"
    class="fixed bottom-24 right-6 z-40 bg-brown-600 hover:bg-brown-500 text-cream-50 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
    onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
    aria-label="Volver arriba"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

  <script>
    const btn = document.getElementById('back-to-top')
    if (btn) {
      window.addEventListener('scroll', () => {
        const show = window.scrollY > 600
        btn.classList.toggle('opacity-100', show)
        btn.classList.toggle('translate-y-0', show)
        btn.classList.toggle('opacity-0', !show)
        btn.classList.toggle('translate-y-4', !show)
        btn.classList.toggle('pointer-events-none', !show)
      })
    }
  </script>
</Layout>
