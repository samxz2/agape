---
import '../styles/global.css'
import Navbar from '../components/Navbar.vue'
import CartDrawer from '../components/CartDrawer.vue'
import ToastBar from '../components/ToastBar.vue'
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'

interface Props {
  title?: string
}

const { title = 'Agape Collection Parfum' } = Astro.props
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Agape Collection Parfum - Fragancias exclusivas de lujo. Perfumes para caballero, damas, unisex y sets." />
    <meta name="theme-color" content="#ece0d4" />
    <title>{title}</title>

    <!-- Preconnects -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fonts with swap display to prevent FOIT -->
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="https://i.ibb.co/CpHdX08t/1001879919.png" />
  </head>
  <body class="bg-cream-50 text-brown-700 min-h-screen">
    <Navbar client:load />
    <CartDrawer client:idle />
    <ToastBar client:idle />
    <Analytics />
    <SpeedInsights />
    <main>
      <slot />
    </main>
    <footer class="bg-cream-100 border-t border-cream-200 text-center py-10 mt-16">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center justify-center gap-2 mb-3">
          <img 
            src="https://i.ibb.co/CpHdX08t/1001879919.png" 
            alt="Agape"
            class="h-6 w-6 rounded-full"
            onerror="this.style.display='none'"
          />
          <p class="font-playfair text-lg text-brown-600 font-bold">Agape Collection Parfum</p>
        </div>
        <p class="text-brown-400/70 text-sm">© 2026 · Todos los derechos reservados</p>
        <div class="flex items-center justify-center gap-4 mt-3 text-xs text-brown-400/60">
          <a href="/terminos" class="hover:text-brown-600 transition-colors">Términos</a>
          <span class="w-px h-3 bg-brown-200/60"></span>
          <a href="/privacidad" class="hover:text-brown-600 transition-colors">Privacidad</a>
          <span class="w-px h-3 bg-brown-200/60"></span>
          <a href="/cookies" class="hover:text-brown-600 transition-colors">Cookies</a>
        </div>
      </div>
    </footer>
  </body>
</html>
